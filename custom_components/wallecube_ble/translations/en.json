  "options": {
    "step": {
      "init": {
        "title": "WalleCube UPS configuration",
        "menu_options": {
          "credentials": "Settings-channel access (AES key / auth code)",
          "adapter": "Power adapter (voltage & current)"
        }
      },
      "credentials": {
        "title": "Settings-channel access (optional)",
        "description": "Optional, and specific to YOUR OWN device - never share these or commit them to a repo. Leave blank to skip; all telemetry sensors work fine without them. See the README for how to extract them for your unit (watch `adb logcat` while opening the official WalleCube app - it prints both values directly).",
        "data": {
          "aes_key": "AES key (32 hex characters)",
          "auth_code": "Auth code (decimal number)"
        }
      },
      "adapter": {
        "title": "Power adapter configuration",
        "description": "Take these from your power adapter's own label — the UPS's output follows them, so a wrong value can feed the wrong voltage to whatever is plugged in.\n\nThe power-off voltage is calculated for you (currently **{power_off} V**), along with the charge limits, exactly as the official app does. They have to agree with the adapter voltage or the UPS will not keep the setting.\n\n**These do not take effect until you press the reset button on the device.**\n\nRange 9-20 V, and the pair must not exceed {watts} W.",
        "data": {
          "adapter_voltage": "Adapter voltage (V)",
          "adapter_current": "Adapter current (A)"
        }
      }
    },
    "error": {
      "invalid_aes_key": "Must be exactly 32 hex characters (16 bytes)",
      "invalid_auth_code": "Must be a decimal number",
      "exceeds_power_rating": "Voltage x current exceeds this UPS's 150 W rating",
      "write_failed": "The UPS did not accept the new settings"
    },
    "abort": {
      "adapter_saved": "Adapter settings saved to the UPS.\n\n**Now press the reset button on the device** — the new voltage and current do not take effect until you do.",
      "adapter_unavailable": "Adapter settings need the AES key and auth code configured first, and an active connection to the UPS.",
      "adapter_not_read_yet": "The current adapter settings haven't been read from the UPS yet - try again in a moment."
    }
  },
